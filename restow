#!/bin/bash
set -euo pipefail

packages="bash hypr waybar ghostty nvim fastfetch starship xdg mpv lazygit walker omarchy-themes omarchy-hooks omarchy-extensions"

cd "$(dirname "$0")"

if [ "${1:-}" = "-n" ]; then
  stow -n $packages
elif [ "${1:-}" = "--adopt" ]; then
  stow --adopt $packages
else
  stow -D $packages 2>/dev/null
  stow $packages
fi
